#!/usr/bin/env python3
"""Basic ICMP ping sweep tool for local lab networks"""
import argparse
import subprocess
import ipaddress
import threading
from concurrent.futures import ThreadPoolExecutor


def ping_host(ip, timeout):
    try:
        # Use system ping command. -c 1 for Linux/macOS, -n 1 for Windows
        ping_count = '1'
        if subprocess.os.name == 'nt':
            cmd = ['ping', '-n', ping_count, '-w', str(int(timeout * 1000)), ip]
        else:
            cmd = ['ping', '-c', ping_count, '-W', str(int(timeout)), ip]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        return res.returncode == 0
    except Exception:
        return False


def main():
    parser = argparse.ArgumentParser(description='Basic ICMP ping sweep')
    parser.add_argument('--subnet', required=True, help='Subnet to scan in CIDR format (e.g., 192.168.1.0/24)')
    parser.add_argument('--timeout', type=int, default=1, help='Timeout per host in seconds')
    parser.add_argument('--concurrency', type=int, default=4, help='Number of parallel pings')
    parser.add_argument('--output', action='store_true', help='Write results to results.txt')
    args = parser.parse_args()

    net = ipaddress.ip_network(args.subnet, strict=False)
    hosts = [str(ip) for ip in net.hosts()]

    reachable = []
    lock = threading.Lock()

    def worker(ip):
        if ping_host(ip, args.timeout):
            with lock:
                reachable.append(ip)

    with ThreadPoolExecutor(max_workers=args.concurrency) as executor:
        for h in hosts:
            executor.submit(worker, h)

    print("Reachable hosts:")
    for ip in sorted(reachable):
        print(ip)
    if args.output:
        with open('results.txt', 'w') as f:
            for ip in sorted(reachable):
                f.write(ip + '\n')

if __name__ == '__main__':
    main()
